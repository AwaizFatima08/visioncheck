{
  "expo": {
    "name": "VisionCheck",
    "slug": "visioncheck",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6FD4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A6FD4"
      },
      "package": "com.visioncheck.app",
      "versionCode": 2,
      "permissions": []
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#1A6FD4",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-sqlite"
      ],
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c487f834-e759-4527-b293-9077e547b8d0"
      }
    },
    "owner": "homi55"
  }
}
